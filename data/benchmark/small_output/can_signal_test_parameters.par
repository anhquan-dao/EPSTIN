# Benchmark template: one selected Monitoring or NoMonitoring test per Variant × Signal.
[TC.CHANGE_VARCODE_VAR_001]
purpose = "Change vehicle variant to VARIANT_001"
UDS_request = ("2E FD DE VARIANT_001")
UDS_response = ("6E FD DE")

[TC.NoMonitoring_Signal_001.VAR_001]
set_preconditions = ("PreconditionSignal"=>"1")
set_CAN_signal = ("Signal_001" => "1")
check_XCP_1 = ("Function_1"=>"0")

