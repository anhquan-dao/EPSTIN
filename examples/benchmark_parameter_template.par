# Benchmark template: one selected Monitoring or NoMonitoring test per Variant × Signal.
[TC.CHANGE_VARCODE_XXXVARIANT_TEST_IDXXX]
purpose = "Change vehicle variant to XXXVARIANT_CODEXXX"
UDS_request = ("2E FD DE XXXVARIANT_CODEXXX")
UDS_response = ("6E FD DE")

@base
[TC.Monitoring_XXXCAN_SIGNALXXX.XXXVARIANT_TEST_IDXXX]
set_CAN_signal = ("XXXCAN_SIGNALXXX" => XXXINVALID_VALUEXXX)
check_XCP_1 = (XXXEXPECTED_DISABLE_FUNCTIONSXXX)

@with_precondition
[TC.Monitoring_XXXCAN_SIGNALXXX.XXXVARIANT_TEST_IDXXX]
set_preconditions = (XXXPRECONDITIONSXXX)
set_CAN_signal = ("XXXCAN_SIGNALXXX" => XXXINVALID_VALUEXXX)
check_XCP_1 = (XXXEXPECTED_DISABLE_FUNCTIONSXXX)

@base
[TC.NoMonitoring_XXXCAN_SIGNALXXX.XXXVARIANT_TEST_IDXXX]
set_CAN_signal = ("XXXCAN_SIGNALXXX" => XXXINVALID_VALUEXXX)
check_XCP_1 = (XXXEXPECTED_DISABLE_FUNCTIONSXXX)

@with_precondition
[TC.NoMonitoring_XXXCAN_SIGNALXXX.XXXVARIANT_TEST_IDXXX]
set_preconditions = (XXXPRECONDITIONSXXX)
set_CAN_signal = ("XXXCAN_SIGNALXXX" => XXXINVALID_VALUEXXX)
check_XCP_1 = (XXXEXPECTED_DISABLE_FUNCTIONSXXX)
